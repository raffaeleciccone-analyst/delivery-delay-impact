/// Conta gli ordini esclusi per stato. NON collegata di proposito: deve mostrare sempre tutti gli 8 stati, anche quando l'analisi è filtrata.
table ControlloStatiOrdine
	lineageTag: 530d3f09-8bbb-4ea1-a3a0-9539561a0d96

	column Ordini
		dataType: int64
		formatString: #,0
		lineageTag: ab137187-dd09-4619-8ece-fde059ff6f74
		sourceColumn: ordini

	column nell_analisi
		dataType: boolean
		lineageTag: 16a9257b-94cc-4b73-ab80-ba63bc6bc085
		sourceColumn: nell_analisi

	column 'Stato dell''ordine'
		dataType: string
		lineageTag: 84e2f9a6-e632-4e6a-8d42-a0a0c4bb87ce
		sourceColumn: order_status

	partition ControlloStatiOrdine = m
		mode: import
		source =
				// Query: ControlloStatiOrdine   -- 8 righe, serve al pannello «cosa NON dice»
				//
				// Buttare via 2.963 ordini senza dire quanti è il modo silenzioso di far mentire
				// un'analisi. Questa tabella li conta, e il pannello dei limiti legge DA QUI
				// invece di avere il numero battuto a mano in una casella di testo.
				// Se un giorno i dati cambiano, il pannello si aggiorna da solo.
				let
				    Origine = OrdiniGrezzi,
				    #"Conta gli scartati per stato" = Table.Group(
				        Origine,
				        {"order_status"},
				        {{"ordini", each Table.RowCount(_), Int64.Type}}
				    ),
				    #"Segna quali entrano nell'analisi" = Table.AddColumn(
				        #"Conta gli scartati per stato",
				        "nell_analisi",
				        each [order_status] = "delivered",
				        type logical
				    ),
				    #"Ordina per numero" = Table.Sort(
				        #"Segna quali entrano nell'analisi", {{"ordini", Order.Descending}}
				    )
				in
				    #"Ordina per numero"

