/// Un ordine consegnato. Base dei tempi e dei venditori.
table Ordini
	lineageTag: fe27c78e-97a4-4765-842c-bf65fc83e685

	/// chiave dell'ordine
	column order_id
		dataType: string
		lineageTag: ca4a13b3-8b95-457e-a615-3d4bd3ba525b
		sourceColumn: order_id

	/// chiave cliente-ordine, NON la persona (vedi Clienti)
	column customer_id
		dataType: string
		lineageTag: 5b801529-a489-4b29-b7ab-a35b067de500
		sourceColumn: customer_id

	column order_status
		dataType: string
		lineageTag: ba8979db-7208-440d-b294-56406f3b8787
		sourceColumn: order_status

	column order_purchase_timestamp
		dataType: dateTime
		lineageTag: 08a7e051-bf26-4ec2-a455-cae22d3271db
		sourceColumn: order_purchase_timestamp

	column order_approved_at
		dataType: dateTime
		lineageTag: 3090094f-7bfd-4da6-bfca-59aa3699b4aa
		sourceColumn: order_approved_at

	column order_delivered_carrier_date
		dataType: dateTime
		lineageTag: 5b6f77a4-5d46-4241-860c-3f7d02eb5186
		sourceColumn: order_delivered_carrier_date

	column order_delivered_customer_date
		dataType: dateTime
		lineageTag: b4644198-1297-4f41-9dd9-ad6be1e3dc7a
		sourceColumn: order_delivered_customer_date

	/// data PROMESSA al cliente, non una previsione
	column order_estimated_delivery_date
		dataType: dateTime
		lineageTag: fecc9f82-64bc-4052-aca2-65b79cc2d648
		sourceColumn: order_estimated_delivery_date

	/// giorni fra la data promessa e la data di consegna; positivo = in ritardo
	column giorni_ritardo
		dataType: int64
		lineageTag: 0af5f7ab-32b1-46e3-9e32-78f19678bd8c
		sourceColumn: giorni_ritardo

	column in_ritardo
		dataType: boolean
		lineageTag: 6749923b-725e-4c5c-b223-e2489d74e092
		sourceColumn: in_ritardo

	/// approvazione -> affidamento al corriere
	column giorni_fase_venditore
		dataType: double
		lineageTag: 6c1f797c-f60e-4193-8962-1d0ad27c056e
		sourceColumn: giorni_fase_venditore

	/// affidamento al corriere -> consegna
	column giorni_fase_logistica
		dataType: double
		lineageTag: 17f40180-4158-4ec9-b191-d1c8a0fc1127
		sourceColumn: giorni_fase_logistica

	/// falso su 1.388 ordini con timestamp incoerenti: escono dalle misure di durata
	column cronologia_ok
		dataType: boolean
		lineageTag: 3442f7e7-215a-48a3-86f4-36b49f5a6c46
		sourceColumn: cronologia_ok

	column data_acquisto
		dataType: dateTime
		lineageTag: a6b10ee8-61b9-404e-badb-83f6cce57c71
		sourceColumn: data_acquisto

	column data_consegna
		dataType: dateTime
		lineageTag: 8224b14a-a4f7-4345-b7de-67185cca38bd
		sourceColumn: data_consegna

	/// media dei punteggi quando l'ordine ha più di una recensione
	column voto
		dataType: double
		lineageTag: 60b34cd4-b7bf-4040-b663-6de1a78beda3
		sourceColumn: voto

	column recensioni_sull_ordine
		dataType: int64
		lineageTag: 73276d84-1f2e-46cc-a1c1-f38708ab7729
		sourceColumn: recensioni_sull_ordine

	/// voto <= 2
	column voto_negativo
		dataType: boolean
		lineageTag: 0758ac14-0413-4148-bb8b-c15159146bf3
		sourceColumn: voto_negativo

	/// distingue le due basi: 96.470 consegnati, 95.824 recensiti
	column recensito
		dataType: boolean
		lineageTag: 283a6b4f-b367-484c-ae5e-fe7148f68491
		sourceColumn: recensito

	/// in orario / in ritardo, in parole invece che Vero-Falso
	column esito_consegna
		dataType: string
		lineageTag: 22127937-2963-47d5-8391-632e1a25995c
		sourceColumn: esito_consegna

	/// serve a mostrare il dirupo: il legame non è una pendenza
	column fascia_ritardo
		dataType: string
		lineageTag: 88e8a8e9-40fb-403a-9ad3-7dbc2a1fa1f4
		sourceColumn: fascia_ritardo
		sortByColumn: fascia_ordine

	/// ordina le fasce; l'ordine alfabetico sarebbe sbagliato
	column fascia_ordine
		dataType: int64
		isHidden
		lineageTag: 7fe84079-fb8c-4727-b8aa-1e55bd807ecc
		sourceColumn: fascia_ordine

	/// il cliente ha risposto prima che il pacco arrivasse: giudica l'attesa, non la consegna
	column recensione_prima_del_pacco
		dataType: boolean
		lineageTag: 4a201d71-48cf-471a-9507-0456ce828e64
		sourceColumn: recensione_prima_del_pacco

	/// prima / dopo aver ricevuto il pacco, in parole
	column momento_recensione
		dataType: string
		lineageTag: d928dcc8-5621-4139-b49a-71cfb22843b2
		sourceColumn: momento_recensione

	/// in linea d'aria fra cliente e venditore più lontano; vuota se un CAP non ha coordinate
	column distanza_km
		dataType: double
		formatString: #,0
		lineageTag: a136c960-7c46-4881-9e9b-5745e6e5fe54
		sourceColumn: distanza_km

	/// cinque fasce di distanza, più 'Distanza non calcolabile'
	column fascia_distanza
		dataType: string
		lineageTag: 0c8a83bc-9ffa-4a9d-a7b2-917b427ac131
		sourceColumn: fascia_distanza
		sortByColumn: fascia_distanza_ordine

	/// ordina le fasce di distanza
	column fascia_distanza_ordine
		dataType: int64
		isHidden
		lineageTag: 558c1917-9e98-4a4e-9c9d-dc6193238996
		sourceColumn: fascia_distanza_ordine

	partition Ordini = m
		mode: import
		source =
				// Query: Ordini   -- tabella dei fatti, grana: un ordine consegnato
				// I passaggi hanno i nomi decisi in DATI-SPORCHI.md.
				//
				// Righe attese: 96.470  (numero 3 di RICONCILIAZIONE.md)
				// di cui recensito = true: 95.824  (numero 4)
				let
				    Origine = OrdiniGrezzi,
				
				    // §1 - solo i consegnati. Gli altri 2.963 non hanno una data di consegna
				    // perché non sono mai arrivati. Quanti sono lo dice ControlloStatiOrdine.
				    #"Tieni solo gli ordini consegnati" = Table.SelectRows(
				        Origine, each [order_status] = "delivered"
				    ),
				
				    // §2 - otto ordini sono marcati consegnati ma non hanno la data.
				    #"Scarta i consegnati senza data di consegna" = Table.SelectRows(
				        #"Tieni solo gli ordini consegnati",
				        each [order_delivered_customer_date] <> null
				    ),
				
				    // Il ritardo è rispetto alla data PROMESSA, non a un tempo ragionevole (§4).
				    // Si confrontano due DATE, non due istanti: la promessa è un giorno e nel file
				    // sta alla mezzanotte, la consegna ha l'ora. Sottraendo gli istanti un pacco
				    // arrivato alle 14 del giorno promesso risultava in ritardo di 0,6 giorni:
				    // erano 1.292 ordini, e la quota in ritardo saliva dal 6,8% all'8,1% (§4b).
				    #"Giorni di ritardo" = Table.AddColumn(
				        #"Scarta i consegnati senza data di consegna",
				        "giorni_ritardo",
				        each Duration.Days(
				            DateTime.Date([order_delivered_customer_date])
				                - DateTime.Date([order_estimated_delivery_date])
				        ),
				        Int64.Type
				    ),
				    #"In ritardo si o no" = Table.AddColumn(
				        #"Giorni di ritardo", "in_ritardo", each [giorni_ritardo] > 0, type logical
				    ),
				    // la stessa cosa in parole: sui grafici "Vero/Falso" non dice niente a nessuno
				    #"Esito della consegna" = Table.AddColumn(
				        #"In ritardo si o no",
				        "esito_consegna",
				        each if [giorni_ritardo] > 0 then "Consegnati in ritardo" else "Consegnati in orario",
				        type text
				    ),
				
				    // Le fasce servono a mostrare il DIRUPO (DATI-SPORCHI.md, ipotesi 1): il legame
				    // fra ritardo e recensione non è una pendenza, e un indicatore riassuntivo
				    // direbbe il falso. Mostrando le fasce si vede dove succede davvero.
				    // I tagli sono gli stessi dell'analisi: -10, -5, 0, 3, 7, 15, 30 giorni. Con i giorni
				    // interi le etichette dicono gli estremi veri: "4-7" è da 4 a 7 compresi.
				    #"Fascia di ritardo" = Table.AddColumn(
				        #"Esito della consegna",
				        "fascia_ritardo",
				        each if [giorni_ritardo] <= -10 then "10 gg o più in anticipo"
				             else if [giorni_ritardo] <= -5 then "5-9 gg in anticipo"
				             else if [giorni_ritardo] <= 0  then "0-4 gg in anticipo"
				             else if [giorni_ritardo] <= 3  then "1-3 gg di ritardo"
				             else if [giorni_ritardo] <= 7  then "4-7 gg di ritardo"
				             else if [giorni_ritardo] <= 15 then "8-15 gg di ritardo"
				             else if [giorni_ritardo] <= 30 then "16-30 gg di ritardo"
				             else "Oltre 30 gg di ritardo",
				        type text
				    ),
				    // l'ordine alfabetico non è l'ordine giusto: serve una colonna per ordinarle
				    #"Ordine della fascia" = Table.AddColumn(
				        #"Fascia di ritardo",
				        "fascia_ordine",
				        each if [giorni_ritardo] <= -10 then 1
				             else if [giorni_ritardo] <= -5 then 2
				             else if [giorni_ritardo] <= 0  then 3
				             else if [giorni_ritardo] <= 3  then 4
				             else if [giorni_ritardo] <= 7  then 5
				             else if [giorni_ritardo] <= 15 then 6
				             else if [giorni_ritardo] <= 30 then 7
				             else 8,
				        Int64.Type
				    ),
				
				    // Le due fasi della sotto-domanda 5: quella del venditore e quella del corriere.
				    #"Fase venditore" = Table.AddColumn(
				        #"Ordine della fascia",
				        "giorni_fase_venditore",
				        each Duration.TotalDays([order_delivered_carrier_date] - [order_approved_at]),
				        type number
				    ),
				    #"Fase logistica" = Table.AddColumn(
				        #"Fase venditore",
				        "giorni_fase_logistica",
				        each Duration.TotalDays([order_delivered_customer_date] - [order_delivered_carrier_date]),
				        type number
				    ),
				
				    // §3 - 1.359 ordini risultano partiti prima di essere approvati: su quelli
				    // le fasi vengono negative. Si MARCANO, non si cancellano: restano nel
				    // fatturato e nel conteggio, escono solo dalle misure di durata.
				    // Righe con cronologia_ok = true attese: 95.082
				    #"Marca la cronologia incoerente" = Table.AddColumn(
				        #"Fase logistica",
				        "cronologia_ok",
				        each [giorni_fase_venditore] <> null
				            and [giorni_fase_logistica] <> null
				            and [giorni_fase_venditore] >= 0
				            and [giorni_fase_logistica] >= 0,
				        type logical
				    ),
				
				    // Due colonne data (senza ora) per agganciare il Calendario.
				    // shipping_limit_date NON entra: è una scadenza contrattuale, e arriva al 2020 (§12).
				    #"Data di acquisto" = Table.AddColumn(
				        #"Marca la cronologia incoerente",
				        "data_acquisto",
				        each DateTime.Date([order_purchase_timestamp]),
				        type date
				    ),
				    #"Data di consegna" = Table.AddColumn(
				        #"Data di acquisto",
				        "data_consegna",
				        each DateTime.Date([order_delivered_customer_date]),
				        type date
				    ),
				
				    // Il voto sta qui e non in una tabella a parte, perché RecensioniPerOrdine
				    // ha già grana un-ordine (§5): tenerla separata aggiungerebbe una relazione
				    // uno-a-uno senza guadagnarci niente.
				    #"Aggancia il voto della recensione" = Table.NestedJoin(
				        #"Data di consegna", {"order_id"},
				        RecensioniPerOrdine, {"order_id"},
				        "rec", JoinKind.LeftOuter
				    ),
				    #"Espandi il voto" = Table.ExpandTableColumn(
				        #"Aggancia il voto della recensione",
				        "rec",
				        {"voto", "recensioni_sull_ordine", "voto_negativo", "prima_risposta"},
				        {"voto", "recensioni_sull_ordine", "voto_negativo", "prima_risposta"}
				    ),
				
				    // LE DUE BASI, dichiarate come colonna invece che ricordate a memoria:
				    // tempi e venditori -> tutti i 96.470;  voti -> i 95.824 con recensito = true.
				    #"Segna se recensito" = Table.AddColumn(
				        #"Espandi il voto", "recensito", each [voto] <> null, type logical
				    ),
				
				    // §16 - Olist manda il questionario il giorno dopo la consegna, ma se il pacco
				    // è in ritardo non lo aspetta: lo manda due giorni dopo la data promessa (4.460
				    // ritardi su 6.409 recensioni). Chi aspetta riceve la domanda mentre il pacco non
				    // c'è, e risponde lo stesso: sui ritardi succede 7 volte su 10. Quelle
				    // recensioni giudicano l'attesa, non la consegna, e vanno contate a parte.
				    // Si confronta la PRIMA risposta con l'istante di consegna.
				    #"Recensione prima del pacco" = Table.AddColumn(
				        #"Segna se recensito",
				        "recensione_prima_del_pacco",
				        each [recensito] and [prima_risposta] <> null
				            and [prima_risposta] < [order_delivered_customer_date],
				        type logical
				    ),
				    #"Momento della recensione" = Table.AddColumn(
				        #"Recensione prima del pacco",
				        "momento_recensione",
				        each if not [recensito] then "Non recensito"
				             else if [recensione_prima_del_pacco] then "Prima di ricevere il pacco"
				             else "Dopo aver ricevuto il pacco",
				        type text
				    ),
				    #"Togli l'istante della risposta" = Table.RemoveColumns(
				        #"Momento della recensione", {"prima_risposta"}
				    ),
				
				    // F10 di SPEC.md - la distanza in linea d'aria fra il cliente e il venditore più
				    // lontano dell'ordine (C19), con la formula dell'emisenoverso. Un CAP senza punto
				    // lascia la distanza vuota per tutto l'ordine (C17): contata, non stimata.
				    Distanza = (lat1 as nullable number, lng1 as nullable number,
				                lat2 as nullable number, lng2 as nullable number) as nullable number =>
				        if lat1 = null or lng1 = null or lat2 = null or lng2 = null then null
				        else
				            let
				                r = Number.PI / 180,
				                a = Number.Power(Number.Sin((lat2 - lat1) * r / 2), 2)
				                    + Number.Cos(lat1 * r) * Number.Cos(lat2 * r)
				                      * Number.Power(Number.Sin((lng2 - lng1) * r / 2), 2)
				            in
				                2 * 6371 * Number.Asin(Number.Sqrt(a)),
				
				    // Le tabelle di appoggio si tengono in memoria (Table.Buffer): senza, Power Query le
				    // ricalcola da capo per ogni ordine, e l'aggiornamento non finisce più (21/11: oltre 20 minuti).
				    Punti = Table.Buffer(CoordinateCAP),
				    CoordCliente = Table.Buffer(Table.ExpandTableColumn(
				        Table.NestedJoin(Table.SelectColumns(Clienti, {"customer_id", "cap"}), {"cap"}, Punti, {"cap"}, "pc", JoinKind.LeftOuter),
				        "pc", {"lat", "lng"}, {"lat_cliente", "lng_cliente"}
				    )),
				    CoordVenditore = Table.Buffer(Table.ExpandTableColumn(
				        Table.NestedJoin(Table.SelectColumns(Venditori, {"seller_id", "cap"}), {"cap"}, Punti, {"cap"}, "pv", JoinKind.LeftOuter),
				        "pv", {"lat", "lng"}, {"lat_venditore", "lng_venditore"}
				    )),
				
				    // Una riga per coppia ordine-venditore, con le due coordinate accanto: le distanze si
				    // calcolano tutte insieme su una tabella piatta, poi si tiene la massima per ordine (C19).
				    ClienteDellOrdine = Table.SelectColumns(#"Togli l'istante della risposta", {"order_id", "customer_id"}),
				    Coppie = Table.Distinct(Table.SelectColumns(RigheOrdine, {"order_id", "seller_id"})),
				    CoppieConCliente = Table.ExpandTableColumn(
				        Table.NestedJoin(Coppie, {"order_id"}, Table.Buffer(ClienteDellOrdine), {"order_id"}, "o", JoinKind.Inner),
				        "o", {"customer_id"}
				    ),
				    CoppieConCoordCliente = Table.ExpandTableColumn(
				        Table.NestedJoin(CoppieConCliente, {"customer_id"}, CoordCliente, {"customer_id"}, "c", JoinKind.LeftOuter),
				        "c", {"lat_cliente", "lng_cliente"}
				    ),
				    CoppieConPunti = Table.ExpandTableColumn(
				        Table.NestedJoin(CoppieConCoordCliente, {"seller_id"}, CoordVenditore, {"seller_id"}, "v", JoinKind.LeftOuter),
				        "v", {"lat_venditore", "lng_venditore"}
				    ),
				    DistanzaCoppia = Table.AddColumn(
				        CoppieConPunti, "km",
				        each Distanza([lat_cliente], [lng_cliente], [lat_venditore], [lng_venditore]),
				        type nullable number
				    ),
				    // se una coppia non ha distanza, l'ordine resta senza (C17): niente massimo sui soli noti
				    DistanzaOrdine = Table.Buffer(Table.Group(
				        DistanzaCoppia, {"order_id"},
				        {{"distanza_km", each if List.Contains([km], null) then null else List.Max([km]), type nullable number}}
				    )),
				    #"Togli le coordinate" = Table.ExpandTableColumn(
				        Table.NestedJoin(#"Togli l'istante della risposta", {"order_id"}, DistanzaOrdine, {"order_id"}, "d", JoinKind.LeftOuter),
				        "d", {"distanza_km"}
				    ),
				
				    // Q3 di SPEC.md - cinque fasce; il taglio cade nella fascia superiore (100 km -> "100-500")
				    #"Fascia di distanza" = Table.AddColumn(
				        #"Togli le coordinate",
				        "fascia_distanza",
				        each if [distanza_km] = null then "Distanza non calcolabile"
				             else if [distanza_km] < 100  then "Sotto 100 km"
				             else if [distanza_km] < 500  then "100-500 km"
				             else if [distanza_km] < 1000 then "500-1.000 km"
				             else if [distanza_km] < 2000 then "1.000-2.000 km"
				             else "Oltre 2.000 km",
				        type text
				    ),
				    #"Ordine della fascia di distanza" = Table.AddColumn(
				        #"Fascia di distanza",
				        "fascia_distanza_ordine",
				        each if [distanza_km] = null then 6
				             else if [distanza_km] < 100  then 1
				             else if [distanza_km] < 500  then 2
				             else if [distanza_km] < 1000 then 3
				             else if [distanza_km] < 2000 then 4
				             else 5,
				        Int64.Type
				    )
				in
				    #"Ordine della fascia di distanza"

